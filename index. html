<!DOCTYPE html><html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>K-Pop Group Maker Quiz 💗</title><style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding: 20px;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #ffd6ec, #e5d5ff);
    color: #56345f;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
}

.container {
    background: white;
    width: 100%;
    max-width: 480px;
    padding: 28px 22px;
    border-radius: 25px;
    text-align: center;
    box-shadow: 0 8px 25px #b88acb55;
}

h1 {
    color: #d64c9c;
    font-size: 27px;
}

.subtitle {
    color: #886493;
    line-height: 1.5;
}

.progress {
    background: #f3e5f8;
    height: 9px;
    border-radius: 20px;
    margin: 22px 0;
    overflow: hidden;
}

#progressBar {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, #ff83c5, #a78bfa);
    transition: width 0.3s;
}

#question {
    font-size: 21px;
    margin: 22px 0;
}

.option {
    display: block;
    width: 100%;
    padding: 14px;
    margin: 10px 0;
    background: #fff0f8;
    border: 2px solid #f4c8e3;
    border-radius: 14px;
    font-size: 16px;
    color: #56345f;
    cursor: pointer;
    text-align: left;
}

.option:hover {
    background: #ffe0f1;
}

.option.selected {
    background: #e9dcff;
    border-color: #a78bfa;
}

button {
    font-size: 16px;
    font-weight: bold;
}

.main-button {
    width: 100%;
    padding: 15px;
    margin-top: 18px;
    border: none;
    border-radius: 14px;
    color: white;
    background: linear-gradient(90deg, #f16bb5, #a78bfa);
    cursor: pointer;
}

.main-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

#result {
    display: none;
}

.result-card {
    background: #fff0f8;
    padding: 18px;
    border-radius: 18px;
    margin-top: 15px;
    line-height: 1.8;
    overflow-wrap: anywhere;
}

.small {
    font-size: 13px;
    color: #9979a2;
    margin-top: 20px;
}
</style></head><body><div class="container"><div id="quiz">
    <h1>🎤 K-Pop Group Maker 💗</h1>
    <p class="subtitle">
        Answer these cute questions and create your dream K-pop group! ✨
    </p>

    <div class="progress">
        <div id="progressBar"></div>
    </div>

    <p id="questionNumber"></p>
    <h2 id="question"></h2>
    <div id="options"></div>

    <button class="main-button" id="nextButton" disabled>
        NEXT ➜
    </button>

    <p class="small">Made with love for K-pop fans ♡</p>
</div>

<div id="result">
    <h1>🎉 Your Group Is Ready! 🎉</h1>
    <p>Your K-pop dreams have come true! 💖</p>

    <div class="result-card" id="resultCard"></div>

    <button class="main-button" onclick="restartQuiz()">
        PLAY AGAIN ↻
    </button>
</div>

</div><script>
const questions = [
    {
        question: "1. What kind of group do you want?",
        options: [
            { text: "🎀 Girl group", value: "Girl Group" },
            { text: "🖤 Boy group", value: "Boy Group" },
            { text: "🌈 Co-ed group", value: "Co-ed Group" }
        ]
    },
    {
        question: "2. How many members should your group have?",
        options: [
            { text: "💗 4 members", value: "4 Members" },
            { text: "✨ 5 members", value: "5 Members" },
            { text: "🌸 7 members", value: "7 Members" },
            { text: "💎 9 members", value: "9 Members" }
        ]
    },
    {
        question: "3. Choose your group's concept!",
        options: [
            { text: "🩷 Cute and dreamy", value: "Cute & Dreamy" },
            { text: "🔥 Girl crush / Powerful", value: "Powerful" },
            { text: "🌙 Dark and mysterious", value: "Dark & Mysterious" },
            { text: "🦋 Elegant and magical", value: "Elegant & Magical" }
        ]
    },
    {
        question: "4. Choose your group's main color!",
        options: [
            { text: "🌸 Pink", value: "Pink" },
            { text: "💜 Purple", value: "Purple" },
            { text: "🖤 Black", value: "Black" },
            { text: "🩵 Sky Blue", value: "Sky Blue" }
        ]
    },
    {
        question: "5. What kind of debut song would you choose?",
        options: [
            { text: "🎶 A catchy pop song", value: "Catchy Pop" },
            { text: "💃 A powerful dance song", value: "Powerful Dance" },
            { text: "🌷 A sweet, dreamy song", value: "Sweet & Dreamy" },
            { text: "🌑 A mysterious song", value: "Mysterious" }
        ]
    }
];

let currentQuestion = 0;
let answers = [];
let selectedOption = null;

const questionElement = document.getElementById("question");
const optionsElement = document.getElementById("options");
const nextButton = document.getElementById("nextButton");

function showQuestion() {
    selectedOption = null;
    nextButton.disabled = true;

    const current = questions[currentQuestion];

    document.getElementById("questionNumber").textContent =
        "Question " + (currentQuestion + 1) + " of " + questions.length;

    questionElement.textContent = current.question;
    optionsElement.innerHTML = "";

    current.options.forEach(function(option) {
        const button = document.createElement("button");
        button.className = "option";
        button.textContent = option.text;

        button.addEventListener("click", function() {
            selectedOption = option.value;

            document.querySelectorAll(".option").forEach(function(item) {
                item.classList.remove("selected");
            });

            button.classList.add("selected");
            nextButton.disabled = false;
        });

        optionsElement.appendChild(button);
    });

    document.getElementById("progressBar").style.width =
        (currentQuestion / questions.length * 100) + "%";

    nextButton.textContent =
        currentQuestion === questions.length - 1
        ? "CREATE MY GROUP 💖"
        : "NEXT ➜";
}

nextButton.addEventListener("click", function() {
    if (selectedOption === null) return;

    answers[currentQuestion] = selectedOption;
    currentQuestion++;

    if (currentQuestion < questions.length) {
        showQuestion();
    } else {
        showResult();
    }
});

function showResult() {
    document.getElementById("quiz").style.display = "none";
    document.getElementById("result").style.display = "block";
    document.getElementById("progressBar").style.width = "100%";

    const memberCount = parseInt(answers[1], 10);
    const memberNames = [
        "Yuna", "Minji", "Jisoo", "Hana", "Sora",
        "Mina", "Nari", "Rina", "Yuri"
    ];

    let membersHTML = "";

    for (let i = 0; i < memberCount; i++) {
        membersHTML += (i + 1) + ". " + memberNames[i] + "<br>";
    }

    const groupNames = {
        "Cute & Dreamy": "Pink Stardust",
        "Powerful": "Neon Queens",
        "Dark & Mysterious": "Midnight Echo",
        "Elegant & Magical": "Moonlight Muse"
    };

    const groupName = groupNames[answers[2]] || "Dream Star";

    document.getElementById("resultCard").innerHTML = `
        <h2>🌟 ${groupName} 🌟</h2>
        <strong>Group Type:</strong> ${answers[0]}<br>
        <strong>Members:</strong> ${answers[1]}<br>
        <strong>Concept:</strong> ${answers[2]}<br>
        <strong>Official Color:</strong> ${answers[3]}<br>
        <strong>Debut Song Style:</strong> ${answers[4]}<br>
        <hr>
        <strong>Meet Your Members! 🎤</strong><br>
        ${membersHTML}
        <p>Congratulations on creating your dream K-pop group! 💗</p>
    `;
}

function restartQuiz() {
    currentQuestion = 0;
    answers = [];
    selectedOption = null;

    document.getElementById("result").style.display = "none";
    document.getElementById("quiz").style.display = "block";

    showQuestion();
}

showQuestion();
</script></body>
</html>